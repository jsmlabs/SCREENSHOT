{
  "manifest_version": 3,
  "name": "SCREENSHOT",
  "version": "1.10.0",
  "description": "Screenshots von Bereichen, Elementen, Tabs, Fenstern und ganzen Seiten. Lokal bearbeiten, als PNG kopieren oder speichern.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "unlimitedStorage",
    "offscreen",
    "clipboardWrite",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SCREENSHOT – Bildschirmaufnahme erstellen"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "capture-visible": {
      "description": "Sichtbaren Bereich als Screenshot aufnehmen"
    },
    "capture-full": {
      "description": "Ganze Webseite als Screenshot aufnehmen"
    }
  }
}
